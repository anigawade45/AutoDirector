# ==============================================================================
# Production Environment Configuration Template
# ------------------------------------------------------------------------------
# SECURITY NOTICE:
# DO NOT store real credentials in this file or commit .env.production to git.
# In production, inject these secrets via an external secrets manager:
# - AWS Secrets Manager / Systems Manager Parameter Store
# - HashiCorp Vault
# - Kubernetes Secrets (SealedSecrets / ExternalSecrets Operator)
# - Doppler / Infisical
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=4000
API_BASE_URL=https://api.studio.ai/api
CORS_ORIGIN=https://studio.ai

# Security & Worker Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET=__INJECT_VIA_SECRETS_MANAGER_MIN_32_CHARS__
INTERNAL_WORKER_SECRET=__INJECT_VIA_SECRETS_MANAGER_MIN_32_CHARS__

# MongoDB Replica Set (rs0 required for multi-document versioned transactions)
MONGODB_URI=mongodb://app_user:__INJECT_MONGO_PASSWORD__@mongodb:27017/ai_video_prod?replicaSet=rs0&authSource=admin&directConnection=true

# Redis Connection (BullMQ queues & Pub/Sub SSE)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=__INJECT_REDIS_PASSWORD__

# AWS S3 Storage & Key Encryption
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=__INJECT_AWS_IAM_ACCESS_KEY__
AWS_SECRET_ACCESS_KEY=__INJECT_AWS_IAM_SECRET_KEY__
S3_BUCKET_NAME=ai-video-prod-storage-us-east-1
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_FORCE_PATH_STYLE=false

# LLM / AI Planner Integration
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-pro
GEMINI_API_KEY=__INJECT_GEMINI_API_KEY__
# OPENAI_API_KEY=__INJECT_OPENAI_API_KEY__

# Binary Execution Paths (in Docker, system FFmpeg is at /usr/bin/ffmpeg)
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

