{
  "name": "@ai-video/backend",
  "version": "1.0.0",
  "description": "Backend API and Workers for AI Video Editing Platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "init:db": "tsx src/scripts/initIndexes.ts",
    "s3:ls": "tsx src/scripts/listS3.ts",
    "start": "node dist/server.js",
    "worker:analysis": "tsx src/workers/analysisWorker.ts",
    "worker:render": "tsx src/workers/renderWorker.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-video/shared": "file:../shared",
    "@aws-sdk/client-s3": "^3.621.0",
    "@aws-sdk/s3-request-presigner": "^3.621.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@google/generative-ai": "^0.21.0",
    "bullmq": "^5.8.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fast-json-patch": "^3.1.1",
    "ioredis": "^5.4.1",
    "mongoose": "^8.5.1",
    "nanoid": "^5.0.7",
    "openai": "^4.55.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
