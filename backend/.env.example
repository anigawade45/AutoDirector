# Server Configuration
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000/api
CORS_ORIGIN=http://localhost:3000

# Authentication & Security
JWT_SECRET=super-secret-jwt-key-replace-in-production
INTERNAL_WORKER_SECRET=worker-hmac-shared-secret-key-32-chars-min

# MongoDB Database (Replica set enabled for transactions)
MONGODB_URI=mongodb://localhost:27017/ai_video_editor?replicaSet=rs0&directConnection=true

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AWS S3 / Object Storage (Compatible with LocalStack or AWS)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET_NAME=ai-video-editing-platform
S3_ENDPOINT=http://127.0.0.1:4566
S3_FORCE_PATH_STYLE=true

# AI Provider Configuration (gemini or openai)
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-pro
GEMINI_API_KEY=
OPENAI_API_KEY=

# Worker Configuration
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
TEMP_MEDIA_DIR=./tmp/media

